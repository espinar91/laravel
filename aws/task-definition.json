{
    "taskDefinitionArn": "arn:aws:ecs:us-east-1:877092167058:task-definition/fow-qa:4",
    "containerDefinitions": [
        {
            "name": "fow-qa",
            "image": "public.ecr.aws/nginx/nginx:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "REDIS_HOST",
                    "value": "redis_endpoint"
                },
                {
                    "name": "AWS_BUCKET",
                    "value": "s3_bucket"
                },
                {
                    "name": "FILESYSTEM_DISK",
                    "value": "s3"
                },
                {
                    "name": "APP_ENV",
                    "value": "qa"
                },
                {
                    "name": "DB_HOST",
                    "value": "db_endpoint"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "secrets": [
                {
                    "name": "DB_PASSWORD",
                    "valueFrom": "arn:aws:ssm:us-east-1:877092167058:parameter/rds_password"
                }
            ],
            "dependsOn": [
                {
                    "containerName": "php",
                    "condition": "HEALTHY"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/fow-qa-ecs-cluster/fow-qa",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "fow-qa-app-"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "bash -c 'exec 3<>/dev/tcp/localhost/80' || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 5,
                "startPeriod": 60
            },
            "systemControls": []
        },
        {
            "name": "php",
            "image": "public.ecr.aws/bitcompat/php-fpm:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 9000,
                    "hostPort": 9000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "startTimeout": 120,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/fow-qa-ecs-cluster/fow-qa",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "fow-qa-php-"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "bash -c 'exec 3<>/dev/tcp/localhost/9000' || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 5,
                "startPeriod": 60
            },
            "systemControls": []
        }
    ],
